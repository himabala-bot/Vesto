# VESTO Django Backend Environment Variables
SECRET_KEY=replace-with-a-very-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.onrender.com,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vesto-app.vercel.app

